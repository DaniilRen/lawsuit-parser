# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=company_parser
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Application Settings
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# API Server
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=

# API Keys (for sources that require authentication)
API_KEY_SOURCE1=your_api_key_here
API_KEY_SOURCE2=another_api_key_here

# Parser Settings
PARALLEL_PARSING=false
MAX_WORKERS=3
REQUEST_TIMEOUT=30
RETRY_COUNT=3
RETRY_DELAY=1

# Proxy Settings (optional)
HTTP_PROXY=http://proxy.example.com:8080
HTTPS_PROXY=https://proxy.example.com:8080
NO_PROXY=localhost,127.0.0.1

# Rate Limiting
REQUESTS_PER_MINUTE=60
REQUESTS_PER_DAY=1000

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here